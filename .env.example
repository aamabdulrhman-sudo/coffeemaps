# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CoffeeMap"

# Database (PostgreSQL)
DATABASE_URL="postgresql://coffeemap:coffeemap_secret@localhost:5432/coffeemap?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Platform Admin bootstrap token (required for /admin/setup — generate with: openssl rand -hex 24)
ADMIN_SETUP_TOKEN=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: OpenAI API Key for AI Review Summaries (falls back to built-in analyzer if unset)
OPENAI_API_KEY=""
