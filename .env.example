# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CoffeeMap"

# Database (PostgreSQL)
DATABASE_URL="postgresql://coffeemap:coffeemap_secret@localhost:5432/coffeemap?schema=public"

# NextAuth / Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Platform Admin bootstrap token (required for /admin/setup — generate with: openssl rand -hex 24)
ADMIN_SETUP_TOKEN=""

# Apple Wallet (optional — enables "Add to Apple Wallet" button when set)
# Needs: Pass Type ID cert + key + Apple WWDR cert (PEM contents, newlines escaped as \n)
APPLE_WALLET_PASS_TYPE_ID=""
APPLE_WALLET_TEAM_ID=""
APPLE_WALLET_SIGNER_CERT=""
APPLE_WALLET_SIGNER_KEY=""
APPLE_WALLET_CERT_PASSWORD=""
APPLE_WALLET_WWDR_CERT=""

# Google Wallet (optional — enables "Save to Google Wallet" button when set)
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_CLIENT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: OpenAI API Key for AI Review Summaries (falls back to built-in analyzer if unset)
OPENAI_API_KEY=""
